{
  "name": "svrp-radio",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.svrp.radio",
    "productName": "SweetVictory Radio",
    "artifactName": "SweetVictoryRadio-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.js",
      "ui/**/*"
    ],
    "win": {
    "target": "nsis",
    "icon": "icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "locklelat",
      "repo": "svrp-radio"
    }
  }
}